
[
  {
    "context": "Editor && VimControl && !menu",
    "bindings": {
      "s": "vim::Left",
      "d": "vim::Down",
      "f": "vim::Up",
      "g": "vim::Right",
      "h": "vim::PushDelete",
      "l": "vim::Substitute",
      "shift-j": "vim::EndOfDocument",
      "k": ["vim::PushFindForward", { "before": false, "multiline": false }],
      "shift-k": [
        "vim::PushFindBackward",
        { "after": false, "multiline": false },
      ],
      "shift-h": "vim::DeleteToEndOfLine",
      "h h": "vim::VisualDeleteLine",
      "j shift-r": "vim::PushReplaceWithRegister",
      "j r n": "editor::Rename",
      "j r r": "editor::FindAllReferences",
      "j r i": "editor::GoToImplementation",
      "j r a": "editor::ToggleCodeActions",
      "j j": "vim::StartOfDocument",
      "j h": "editor::Hover",
      "j B": "editor::BlameHover",
      "j d": "editor::GoToDefinition",
      "j shift-d": "editor::GoToDeclaration",
      "j y": "editor::GoToTypeDefinition",
      "j shift-i": "editor::GoToImplementation",
      "j x": "editor::OpenUrl",
      "j f": "editor::OpenSelectedFilename",
      "j n": "vim::SelectNextMatch",
      "j shift-n": "vim::SelectPreviousMatch",
      "j l": "vim::SelectNext",
      "j shift-l": "vim::SelectPrevious",
      "j >": ["editor::SelectNext", { "replace_newest": true }],
      "j <": ["editor::SelectPrevious", { "replace_newest": true }],
      "j a": "editor::SelectAllMatches",
      "j s": "outline::Toggle",
      "j shift-o": "outline::Toggle",
      "j shift-s": "project_symbols::Toggle",
      "j .": "editor::ToggleCodeActions", // zed specific
      "j shift-a": "editor::FindAllReferences", // zed specific
      "j space": "editor::OpenExcerpts", // zed specific
      "j *": ["vim::MoveToNext", { "partial_word": true }],
      "j #": ["vim::MoveToPrevious", { "partial_word": true }],
      "j g": ["vim::Down", { "display_lines": true }],
      "j down": ["vim::Down", { "display_lines": true }],
      "j k": ["vim::Up", { "display_lines": true }],
      "j up": ["vim::Up", { "display_lines": true }],
      "j $": ["vim::EndOfLine", { "display_lines": true }],
      "j end": ["vim::EndOfLine", { "display_lines": true }],
      "j 0": ["vim::StartOfLine", { "display_lines": true }],
      "j home": ["vim::StartOfLine", { "display_lines": true }],
      "j shift-m": ["vim::MiddleOfLine", { "display_lines": true }],
      "j ^": ["vim::FirstNonWhitespace", { "display_lines": true }],
      "j v": "vim::RestoreVisualSelection",
      "j ]": "editor::GoToDiagnostic",
      "j [": "editor::GoToPreviousDiagnostic",
      "j i": "vim::InsertAtPrevious",
      "j ,": "vim::ChangeListNewer",
      "j ;": "vim::ChangeListOlder",
    },
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      ":": "vim::VisualCommand",
      "u": "vim::ConvertToLowerCase",
      "shift-u": "vim::ConvertToUpperCase",
      "shift-o": "vim::OtherEnd",
      "o": "vim::OtherEndRowAware",
      "h": "vim::VisualDelete",
      "j ctrl-a": ["vim::Increment", { "step": true }],
      "j ctrl-x": ["vim::Decrement", { "step": true }],
      "j shift-i": "vim::VisualInsertFirstNonWhiteSpace",
      "j shift-a": "vim::VisualInsertEndOfLine",
      "j shift-j": "vim::JoinLinesNoWhitespace",
      "j shift-r": ["vim::Paste", { "preserve_clipboard": true }],
      "j c": "vim::ToggleComments",
      "j b": "vim::ToggleBlockComments",
      "j q": "vim::Rewrap",
      "j w": "vim::Rewrap",
      "j ?": "vim::ConvertToRot13",
    },
  },
]
